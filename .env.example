# Site
NEXT_PUBLIC_SITE_URL=

# Payload + MongoDB
PAYLOAD_SECRET=
MONGODB_URI=

# Vercel Blob (auto-provisioned when you enable Blob in Vercel)
BLOB_READ_WRITE_TOKEN=

# Email
RESEND_API_KEY=
# Optional: Resend "From" address. Defaults to onboarding@resend.dev.
# Replace with your verified domain when ready (e.g. "Spacehole <hello@yourdomain.com>").
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami Analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
