# ─────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────

# Public URL of the site (used for SEO metadata, OG tags, sitemap, robots)
# Production: https://spacehole.tech
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────
# Resend (transactional email — contact form)
# Get your key: https://resend.com/api-keys
# ─────────────────────────────────────────────────────────

RESEND_API_KEY=

# ─────────────────────────────────────────────────────────
# Cloudflare Turnstile (anti-spam on contact form)
# Get your keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Tier free: 1M validations/month
# Cloudflare provides "always-passes" test keys for local dev:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
# Leave these blank in dev to use the test keys automatically.
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────
# Umami Analytics (privacy-first, GDPR-compliant)
# Sign up: https://cloud.umami.is/
# Free tier: 100k events/month
# Leave NEXT_PUBLIC_UMAMI_WEBSITE_ID blank to disable analytics.
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# ─────────────────────────────────────────────────────────
# Payload CMS (self-hosted in same Next.js app, /admin route)
# - PAYLOAD_SECRET: any random string >=32 chars (for JWT signing).
#   Generate one: openssl rand -base64 32
# - MONGODB_URI: connection string from MongoDB Atlas
#   (free M0 cluster is plenty for a portfolio)
#   Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>
# ─────────────────────────────────────────────────────────

PAYLOAD_SECRET=
MONGODB_URI=
