# Site
NEXT_PUBLIC_SITE_URL=

# Email
RESEND_API_KEY=
# Optional: Resend "From" address. Defaults to onboarding@resend.dev.
# Replace with your verified domain when ready (e.g. "Spacehole <hello@yourdomain.com>").
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami Analytics. Without a website id the script isn't loaded.
# Served from /stats on the site's own domain (see next.config.mjs).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: self-hosted Umami instead of Umami Cloud (no trailing slash).
# UMAMI_HOST=https://umami.yourdomain.com

